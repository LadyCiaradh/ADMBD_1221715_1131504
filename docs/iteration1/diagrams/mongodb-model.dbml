Project TVDE_MongoDB_Model {
  Note: '''
    Ride-Hailing Platform (TVDE)

    Conceptual MongoDB document model.

    The structures represented as tables in this diagram correspond
    to MongoDB collections/documents and NOT relational tables.

    References to PostgreSQL identifiers are logical application-level
    references and are NOT foreign keys.
  '''
}


/* =========================================================
   COLLECTION: driver_locations
   ========================================================= */

Table driver_locations {
  _id ObjectId [pk]

  driver_id bigint [not null, note: 'Logical reference to PostgreSQL Driver']

  location_type varchar [not null, note: 'GeoJSON type: Point']

  longitude decimal [not null]
  latitude decimal [not null]

  availability varchar [not null, note: 'AVAILABLE, BUSY or OFFLINE']

  timestamp datetime [not null]

  Note: '''
    MongoDB Collection.

    Stores operational driver location observations.

    Actual MongoDB representation:

    location: {
      type: "Point",
      coordinates: [longitude, latitude]
    }

    driver_id logically references PostgreSQL Driver.driver_id.
  '''
}


/* =========================================================
   COLLECTION: trip_events
   ========================================================= */

Table trip_events {
  _id ObjectId [pk]

  trip_id bigint [not null, note: 'Logical reference to PostgreSQL Trip']

  event_type varchar [not null]

  timestamp datetime [not null]

  location json [note: 'Optional GeoJSON Point']

  metadata json [note: 'Flexible event-specific metadata']

  Note: '''
    MongoDB Collection.

    Stores the operational event history generated during a trip.

    metadata may have different structures depending on event_type.

    Trip.status in PostgreSQL remains the authoritative current
    state of the trip.
  '''
}


/* =========================================================
   COLLECTION: notifications
   ========================================================= */

Table notifications {
  _id ObjectId [pk]

  recipient_type varchar [not null, note: 'PASSENGER or DRIVER']

  recipient_id bigint [not null, note: 'Logical PostgreSQL entity identifier']

  type varchar [not null]

  message text [not null]

  related_trip_id bigint [note: 'Optional logical reference to PostgreSQL Trip']

  status varchar [not null, note: 'UNREAD or READ']

  created_at datetime [not null]

  read_at datetime

  Note: '''
    MongoDB Collection.

    Stores operational notifications generated by the platform.

    recipient_id and related_trip_id are logical references.
    MongoDB does not enforce foreign keys to PostgreSQL.
  '''
}